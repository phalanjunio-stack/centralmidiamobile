{
  "expo": {
    "name": "Contourline",
    "slug": "contourline-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.contourline.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O app precisa acessar sua galeria para fazer backup automático das fotos.",
        "NSCameraUsageDescription": "O app usa a câmera para escanear o QR code do servidor.",
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.contourline.mobile",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Permite backup automático das fotos.",
          "savePhotosPermission": "Permite salvar fotos."
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite escanear o QR code do servidor."
        }
      ],
      "expo-font",
      "expo-image"
    ]
  }
}
